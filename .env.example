# Copie para .env e preencha com os dados do projeto Supabase (Settings > API).
# Sem essas variáveis o site abre em MODO DEMONSTRAÇÃO (dados salvos só no navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Mostra "Direct" e "Assistente IA" no painel. Ligue (true) só depois de configurar o bot do Instagram.
VITE_IA_ATIVA=
